# Streamlit Secrets Template for ThreatGuard
# In Streamlit Cloud, populate these in the app's Secrets management dashboard.

[general]
app_name = "ThreatGuard – Cyber Incident Detection & Response System"
environment = "production"

[security]
initial_admin_username = "admin"
initial_admin_password = "Admin@ThreatGuard2026!"
secret_key = "replace-with-a-random-secure-secret-token"

[database]
# Path relative to workspace or /tmp for ephemeral storage
path = "threatguard.db"

[detection]
brute_force_threshold = 5
port_scan_port_threshold = 10
time_window_minutes = 15
suspicious_ip_threshold = 8
