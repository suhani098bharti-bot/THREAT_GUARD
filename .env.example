# ThreatGuard Environment Configuration
THREATGUARD_ENV=development
APP_NAME=ThreatGuard
APP_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Default Admin Setup (Used for initial DB bootstrap if admin does not exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@ThreatGuard2026!

# Database Configuration
DATABASE_PATH=threatguard.db

# Detection Config Defaults
BRUTE_FORCE_THRESHOLD=5
PORT_SCAN_PORT_THRESHOLD=10
TIME_WINDOW_MINUTES=15
SUSPICIOUS_IP_THRESHOLD=8
